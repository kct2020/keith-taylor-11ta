{
  "name": "keith-taylor-11ta",
  "version": "1.0.0",
  "description": "Source for shrewdies.net",
  "author": "Keith Taylor",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kct2020/keith-taylor-11ta/issues"
  },
  "homepage": "https://github.com/kct2020/keith-taylor-11ta#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kct2020/keith-taylor-11ta.git"
  },
  "keywords": [
    "11ty",
    "TailwindCSS",
    "TailwindUI",
    "Alpine.js",
    "webpack",
    "PostCSS",
    "CSSnano"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "dev:webpack": "webpack  --mode development",
    "dev:eleventy": "eleventy --serve",
    "dev:postcss": "postcss src/assets/css/tailwind.css -o dist/assets/tailwind.css --watch",
    "dev": "npm-run-all clean --parallel dev:* --print-label",
    "build:webpack": "webpack  --mode production",
    "build:eleventy": "ELEVENTY_ENV=production eleventy",
    "build:postcss": "NODE_ENV=production postcss src/assets/css/tailwind.css -o dist/assets/tailwind.css",
    "build": "run-s clean build:* --print-label"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@11ty/eleventy-navigation": "1.0.5",
    "@11ty/eleventy-plugin-rss": "3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "5.0.2",
    "@babel/core": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "alpinejs": "3.17.1",
    "autoprefixer": "10.5.5",
    "axios": "1.20.0",
    "babel-loader": "10.1.1",
    "clean-css": "5.3.3",
    "cssnano": "9.0.2",
    "dotenv": "17.4.2",
    "html-minifier": "4.0.0",
    "luxon": "3.7.2",
    "markdown-it": "15.0.1",
    "markdown-it-emoji": "3.1.0",
    "npm-run-all": "4.1.5",
    "postcss-cli": "12.0.0",
    "postcss-import": "17.0.0",
    "rimraf": "6.1.3",
    "slugify": "1.6.9",
    "svg-sprite": "2.0.4",
    "tailwindcss": "4.3.3",
    "terser-webpack-plugin": "5.6.1",
    "webpack": "5.110.3",
    "webpack-cli": "7.2.3"
  }
}
